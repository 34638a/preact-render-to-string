{
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": [
            "es2022",
            "dom"
        ],
        "strict": true,
        "strictNullChecks": true,
        "strictFunctionTypes": true,
        "baseUrl": "../",
        "typeRoots": [
            "../"
        ],
        "jsx": "react",
        "jsxFactory": "h",
        "types": ["node"],
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": [
        "src/**/*.ts"
    ]
}
